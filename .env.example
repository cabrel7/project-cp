# =============================================================================
# project-cp — Variables d'environnement (developpement local)
# Copier vers .env et adapter si necessaire. .env est ignore par git.
# En production, les secrets sont dans Infisical (jamais dans .env).
# Legende : [S] = sensible (secret), [-] = non sensible. Toutes les valeurs ci-dessous sont des valeurs de DEV.
# =============================================================================

# ---------- PostgreSQL --------------------------------------------------------
POSTGRES_DB=cp_dev                 # [-] nom de la base
POSTGRES_USER=cp_owner             # [-] proprietaire du schema (migrations dbmate uniquement)
POSTGRES_PASSWORD=cp_owner_dev     # [S] mot de passe du proprietaire
POSTGRES_PORT=5432                 # [-] port hote

# Mots de passe des users applicatifs (crees une seule fois a l'init du volume : `pnpm infra:reset` pour les changer)
CP_DB_PASSWORD_RW=cp_rw_dev             # [S] cp_rw (RLS applique)
CP_DB_PASSWORD_AUTH=cp_auth_dev         # [S] cp_auth (BYPASSRLS, apps/auth)
CP_DB_PASSWORD_ADMIN=cp_admin_dev       # [S] cp_admin (BYPASSRLS, back-office)
CP_DB_PASSWORD_RO=cp_readonly_dev       # [S] cp_readonly (BYPASSRLS, lecture)

# URLs de connexion [S] (contiennent le mot de passe)
DATABASE_URL=postgres://cp_owner:cp_owner_dev@localhost:5432/cp_dev?sslmode=disable
DATABASE_URL_RW=postgres://cp_rw:cp_rw_dev@localhost:5432/cp_dev?sslmode=disable
DATABASE_URL_AUTH=postgres://cp_auth:cp_auth_dev@localhost:5432/cp_dev?sslmode=disable
DATABASE_URL_ADMIN=postgres://cp_admin:cp_admin_dev@localhost:5432/cp_dev?sslmode=disable
DATABASE_URL_READONLY=postgres://cp_readonly:cp_readonly_dev@localhost:5432/cp_dev?sslmode=disable

DBMATE_DATABASE_URL=postgres://cp_owner:cp_owner_dev@localhost:5432/cp_dev?sslmode=disable  # [S]
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_NO_DUMP_SCHEMA=true

# ---------- Redis -------------------------------------------------------------
REDIS_URL=redis://localhost:6379   # [-] en dev (sans mot de passe)
REDIS_PORT=6379                    # [-] port hote

# ---------- MinIO (S3 compatible) --------------------------------------------
MINIO_ROOT_USER=cp_minio           # [S] compte racine MinIO
MINIO_ROOT_PASSWORD=cp_minio_dev   # [S]
MINIO_API_PORT=9000                # [-]
MINIO_CONSOLE_PORT=9001            # [-]
S3_ENDPOINT=http://localhost:9000  # [-]
S3_ACCESS_KEY=cp_minio             # [S]
S3_SECRET_KEY=cp_minio_dev         # [S]
S3_BUCKET=cp-dev                   # [-] cree automatiquement par minio-init
S3_REGION=us-east-1                # [-]
S3_FORCE_PATH_STYLE=true           # [-] requis pour MinIO

# ---------- Mailpit (email) ---------------------------------------------------
SMTP_HOST=localhost                # [-]
SMTP_PORT=1025                     # [-]
SMTP_SECURE=false                  # [-]
SMTP_USER=                         # [S] vide en dev
SMTP_PASSWORD=                     # [S] vide en dev
MAILPIT_UI_PORT=8025               # [-]
MAILPIT_SMTP_PORT=1025             # [-]

# ---------- LiteLLM (4010 : le 4000 est reserve a apps/api) -------------------
LITELLM_PORT=4010                  # [-] port hote
LITELLM_MASTER_KEY=sk-litellm-dev-key  # [S]
LITELLM_BASE_URL=http://localhost:4010 # [-]

# ---------- Temporal ----------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233    # [-]
TEMPORAL_NAMESPACE=default         # [-]
TEMPORAL_GRPC_PORT=7233            # [-]
TEMPORAL_UI_PORT=8233              # [-]

# ---------- App ---------------------------------------------------------------
NODE_ENV=development               # [-]
LOG_LEVEL=debug                    # [-]
