{
  "name": "@cp/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "lefthook install",
    "infra:up": "bash infra/scripts/dev-up.sh",
    "infra:down": "bash infra/scripts/dev-down.sh",
    "infra:reset": "bash infra/scripts/dev-down.sh --volumes 2>/dev/null; rm -rf .local/pg-data .local/redis-data; bash infra/scripts/dev-up.sh",
    "db:up": "bash db/dbmate.sh up",
    "db:rollback": "bash db/dbmate.sh rollback",
    "db:status": "bash db/dbmate.sh status",
    "db:create": "bash db/dbmate.sh create",
    "db:new": "bash db/dbmate.sh new",
    "db:test": "bash db/tests/run.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
