{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(dbmate drop:*)",
      "Bash(dbmate rollback:*)",
      "Bash(dbmate down:*)",
      "Bash(dropdb:*)",
      "Bash(docker compose down:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(pnpm changeset publish:*)",
      "Bash(drizzle-kit push:*)",
      "Bash(drizzle-kit generate:*)",
      "Bash(drizzle-kit migrate:*)",
      "Bash(pnpm drizzle-kit push:*)",
      "Bash(pnpm drizzle-kit generate:*)",
      "Bash(pnpm drizzle-kit migrate:*)",
      "Bash(infisical secrets set:*)",
      "Bash(infisical secrets delete:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cp-session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cp-guard-pretool.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cp-subagent-test-gate.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
